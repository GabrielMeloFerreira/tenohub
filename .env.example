# Supabase — Project Settings › Database › Connection string
# DATABASE_URL: pooler de transação (porta 6543), usado pela aplicação
DATABASE_URL=
# DIRECT_URL: conexão direta (porta 5432), usada só pelas migrations do Drizzle
DIRECT_URL=

# Supabase — Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA expor ao cliente (sem prefixo NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
